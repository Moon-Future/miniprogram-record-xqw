/* pages/detail/index.wxss */
page {
  background-color: #f5f5f5;
}

.container {
  min-height: 100vh;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #1989fa 0%, #0c7cd5 100%);
  padding: 40rpx 30rpx;
  color: white;
}

.guest-name {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.guest-summary {
  display: flex;
  gap: 60rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
}

.summary-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 48rpx;
  font-weight: 600;
}

.summary-value.reward {
  color: #ffe066;
}

/* 记录列表 */
.record-list {
  padding: 20rpx;
}

.record-item {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.record-item.reward {
  background: linear-gradient(135deg, #fff9e6 0%, #fff3cc 100%);
  border: 2rpx solid #ffd633;
}

.record-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.record-content {
  flex: 1;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 26rpx;
  color: #999;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 100rpx 0;
}
