/* index.wxss */
page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.container {
  padding: 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 搜索框 */
.search-wrapper {
  padding: 20rpx;
  padding-bottom: 0;
  background: white;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.search-clear text {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
}

/* 客人列表 */
.guest-list {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 160rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 100rpx 0;
}

.guest-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.guest-left {
  flex: 1;
}

.guest-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.reward-tag {
  margin-left: 16rpx;
  background: linear-gradient(135deg, #ff976a 0%, #ff6b35 100%);
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: normal;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}

.guest-stats {
  display: flex;
  gap: 40rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.stat-value.reward {
  color: #ff976a;
}

.last-visit {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

.guest-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.current-count-big {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
}

.current-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #1989fa;
  line-height: 1;
}

.current-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.4;
}

/* 添加按钮 */
.add-btn-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx 40rpx;
  background: linear-gradient(to top, #f5f5f5 80%, transparent);
  box-sizing: border-box;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1989fa 0%, #0c7cd5 100%);
  color: white;
  border-radius: 50rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 20rpx rgba(25, 137, 250, 0.3);
}

.add-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
  line-height: 1;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 560rpx;
  max-height: 75vh;
  background: white;
  border-radius: 24rpx;
  padding: 32rpx 32rpx;
  animation: slideUp 0.3s ease;
  overflow-y: auto;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  color: #333;
  margin-bottom: 24rpx;
}

.modal-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  margin-bottom: 40rpx;
}

.modal-input:focus {
  border-color: #1989fa;
}

.modal-buttons {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #1989fa 0%, #0c7cd5 100%);
  color: white;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  gap: 12rpx;
}

.action-btn.add-count {
  background: linear-gradient(135deg, #1989fa 0%, #0c7cd5 100%);
  color: white;
}

.action-btn.give-reward {
  background: linear-gradient(135deg, #ff976a 0%, #ff6b35 100%);
  color: white;
}

.action-btn.give-reward.disabled {
  background: #e5e5e5;
  color: #999;
}

.action-btn.minus-count {
  background: linear-gradient(135deg, #666 0%, #444 100%);
  color: white;
}

.action-btn.minus-count.disabled {
  background: #e5e5e5;
  color: #999;
}

.action-icon {
  font-size: 36rpx;
}

/* 当前统计 */
.current-stats {
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 0;
}

.stat-row .highlight {
  color: #1989fa;
  font-weight: 600;
  font-size: 28rpx;
}

/* 光临历史 */
.visit-history {
  margin-bottom: 16rpx;
}

.history-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.history-list {
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 12rpx 20rpx;
}

.history-item {
  padding: 8rpx 0;
  border-bottom: 1rpx solid #eee;
}

.history-item:last-child {
  border-bottom: none;
}

.history-time {
  font-size: 24rpx;
  color: #666;
}

/* 详情按钮 */
.detail-btn {
  width: 100%;
  height: 70rpx;
  background: white;
  color: #1989fa;
  border: 2rpx solid #1989fa;
  border-radius: 10rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  padding: 0;
}

/* 修改姓名按钮 */
.detail-btn:nth-of-type(2) {
  color: #ff976a;
  border-color: #ff976a;
}

/* 删除按钮 */
.delete-btn {
  width: 100%;
  height: 70rpx;
  background: white;
  color: #e54545;
  border: 2rpx solid #e54545;
  border-radius: 10rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  padding: 0;
}

/* 关闭按钮 */
.close-btn {
  width: 100%;
  height: 76rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 10rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}
