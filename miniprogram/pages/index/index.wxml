<!--index.wxml-->
<view class="container">
  <!-- 搜索框 -->
  <view class="search-wrapper">
    <view class="search-box">
      <input class="search-input" placeholder="搜索客人姓名" value="{{searchKeyword}}" bindinput="onSearchInput" />
      <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">
        <text>×</text>
      </view>
    </view>
  </view>

  <!-- 客人列表 -->
  <view class="guest-list">
    <view wx:if="{{guestList.length === 0}}" class="empty-tip">
      暂无客人，点击下方按钮添加
    </view>

    <view wx:for="{{guestList}}" wx:key="_id" class="guest-item" bindtap="showGuestActions" data-guest="{{item}}">
      <image class="guest-avatar" src="{{item.avatarUrl || '/images/avatar.png'}}" mode="aspectFill" catchtap="previewAvatar" data-avatar="{{item.avatarUrl}}" />
      <view class="guest-left">
        <view class="guest-name">
          {{item.name}}
          <view wx:if="{{item.currentCount >= 10}}" class="reward-tag">待发奖</view>
        </view>
        <view class="guest-stats">
          <view class="stat-item">
            <text class="stat-label">历史</text>
            <text class="stat-value">{{item.totalCount}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">奖励</text>
            <text class="stat-value reward">{{item.rewardCount}}</text>
          </view>
        </view>
        <view wx:if="{{item.visitHistory && item.visitHistory.length > 0}}" class="last-visit">
          上次：{{item.visitHistory[0].timeStr}}
        </view>
      </view>
      <view class="guest-right">
        <view class="current-count-big">
          <text class="current-num">{{item.currentCount}}</text>
          <text class="current-label">/10</text>
        </view>
        <image class="arrow" src="../../images/arrow.svg"></image>
      </view>
    </view>
  </view>

  <!-- 添加客人按钮 -->
  <view class="add-btn-wrapper">
    <view class="add-btn" bindtap="showAddModal">
      <text class="add-icon">+</text>
      <text>添加客人</text>
    </view>
  </view>

  <!-- 添加客人弹窗 -->
  <view wx:if="{{showAdd}}" class="modal-mask" bindtap="hideAddModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">添加新客人</view>
      <!-- 头像选择 -->
      <view class="add-avatar-section">
        <view class="add-avatar-wrapper" bindtap="chooseAddAvatar">
          <image
            class="add-avatar"
            src="{{tempAddAvatarPath || '/images/avatar.png'}}"
            mode="aspectFill"
          />
          <view class="add-avatar-edit-badge">
            <text class="add-camera-icon">📷</text>
          </view>
        </view>
        <text class="add-avatar-tip">点击添加头像</text>
      </view>
      <input class="modal-input" placeholder="请输入客人姓名" value="{{newGuestName}}" bindinput="onNameInput" />
      <view class="modal-buttons">
        <button class="modal-btn cancel" bindtap="hideAddModal">取消</button>
        <button class="modal-btn confirm" bindtap="addGuest" disabled="{{adding}}">
          {{adding ? '添加中...' : '确定'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 客人操作弹窗 -->
  <view wx:if="{{showActions}}" class="modal-mask" bindtap="hideGuestActions">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">{{selectedGuest.name}}</view>
      <view class="action-buttons">
        <button class="action-btn add-count" bindtap="incrementCount">
          <text class="action-icon">👋</text>
          <text>光临次数 +1</text>
        </button>
        <button class="action-btn minus-count {{selectedGuest.currentCount <= 0 ? 'disabled' : ''}}" bindtap="decrementCount">
          <text class="action-icon">↩️</text>
          <text>光临次数 -1</text>
        </button>
        <button class="action-btn give-reward {{selectedGuest.currentCount < 10 ? 'disabled' : ''}}" bindtap="giveReward">
          <text class="action-icon">🎁</text>
          <text>发放奖励</text>
        </button>
      </view>
      <view class="current-stats">
        <view class="stat-row">
          <text>本次光临：</text>
          <text class="highlight">{{selectedGuest.currentCount}}/10</text>
        </view>
        <view class="stat-row">
          <text>历史累计：</text>
          <text>{{selectedGuest.totalCount}}次</text>
        </view>
        <view class="stat-row">
          <text>已发奖励：</text>
          <text>{{selectedGuest.rewardCount}}次</text>
        </view>
      </view>

      <!-- 查看详情按钮 -->
      <button class="detail-btn" bindtap="goToDetail">查看完整记录</button>

      <!-- 修改客人信息按钮 -->
      <button class="detail-btn" bindtap="goToEdit">修改客人信息</button>

      <!-- 删除按钮 -->
      <button class="delete-btn" bindtap="deleteGuest">删除客人</button>

      <button class="close-btn" bindtap="hideGuestActions">关闭</button>
    </view>
  </view>
</view>
